		"lucide-svelte": "^1.0.1",
		"svelte": "^5.56.0",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.3",
		"vite": "^8.0.14",
		"vitest": "^4.1.2"
	},
	"dependencies": {
