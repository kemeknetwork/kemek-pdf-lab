{
	"name": "kemek-pdf-lab",
	"private": true,
	"version": "0.35.8",
	"type": "module",
	"engines": {
		"node": "^22.17.0 || ^24.0.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json --watch",
		"check:ts6": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26.6.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vite-pwa/sveltekit": "^2.0.0",
		"lucide-svelte": "^1.0.1",
		"magicast": "^0.5.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@neslinesli93/qpdf-wasm": "0.3.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.5.438",
		"svelte-dnd-action": "^0.9.79"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
