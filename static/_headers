# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
# Inert in the repo and in `vite dev`/`preview`; only applied by Cloudflare Pages
# (or `wrangler pages dev build`, which is how this file is verified locally).

/*
  # The privacy thesis, made browser-enforced rather than merely claimed. Every asset
  # is self-hosted (PDF worker, qpdf.wasm, fonts), so the app issues ZERO cross-origin
  # requests — and `connect-src 'self'` blocks every PROGRAMMATIC channel a script
  # could use to ship bytes off-device (fetch / XHR / sendBeacon / WebSocket), with
  # `default-src 'self'` backstopping the rest and `form-action 'self'` blocking
  # form-POST exfil. (CSP can't stop bytes smuggled through a top-level navigation —
  # no shipped directive does — but that needs injected script, and there's no
  # injection surface: Svelte auto-escapes, no {@html} of user data, no external
  # scripts.) connect-src is the channel a skeptic verifies in the Network tab; here
  # it is non-bypassable.
  #
  #   script-src: 'wasm-unsafe-eval' for the qpdf / pdf.js WebAssembly. The inline
  #     scripts (app.html's boot/theme/crypto-shim, SvelteKit's hydration bootstrap)
  #     are allowed by hash in the <meta> policy described below.
  #   style-src / img-src 'unsafe-inline' / data: / blob: cover Svelte `style:` directives,
  #     the build-inlined CSS, and canvas thumbnails (data: PNGs).
  #   'unsafe-inline' in script-src is NOT the effective policy: the built page also
  #     carries a <meta> CSP (`kit.csp` in vite.config.ts, hash mode) whose script-src
  #     lists exact hashes, and a browser enforces both policies, so only the hashed
  #     inline scripts run. It stays here so the header alone never breaks the boot.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()
  # HTTPS-only for this host. No includeSubDomains: sibling kemek.com hosts are
  # served elsewhere, and this header must never decide their transport.
  Strict-Transport-Security: max-age=31536000
  # Own browsing-context group: no cross-origin window can hold a reference to
  # this tab. Safe without COEP (nothing here opens or is opened by another site).
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # Cloudflare injects Network Error Logging, which has the BROWSER post failure
  # reports to a.nel.cloudflare.com out of band — a cross-origin request the
  # Network tab never shows. A max_age of 0 retracts the policy, and detaching
  # the platform's headers removes the report endpoint.
  ! NEL
  ! Report-To
  NEL: {"max_age":0}

# The social card is fetched by other sites' previews, so it must stay embeddable.
/og-image.png
  ! Cross-Origin-Resource-Policy

# Content-hashed app bundle — filenames change on every rebuild, so cache forever.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Big UNHASHED engines: their URL never changes across a version bump, so any
# max-age lets a browser pair the NEW hashed app bundle with its cached OLD engine —
# and pdf.js hard-fails on an API/worker mismatch (every PDF dies, UnknownErrorException).
# `no-cache` = store but revalidate every load: a 304 when unchanged, the new bytes
# the moment a deploy changes them. This governs requests the service worker doesn't
# answer: once it controls the page, the worker comes from its precache (revisioned,
# updates with the app) and qpdf.wasm from a runtime cache named for its version
# (vite.config.ts). Fonts stay stable, so cache forever.
/pdf.worker.min.mjs
  Cache-Control: public, no-cache
/qpdf.wasm
  Cache-Control: public, no-cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# pdf.js decoders and font data, served under a path named for the pdfjs version
# (vite.pdfjs-assets.ts), so a URL's bytes never change.
/pdfjs/*
  Cache-Control: public, max-age=31536000, immutable
